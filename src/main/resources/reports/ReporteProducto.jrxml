<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteProducto" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="642fecd5-f298-4a58-9673-c826a55b328f">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="InventarioLocalPosgres"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="P_ID_PRODUCTO" class="java.lang.String"/>
	<parameter name="P_FECHA_INICIO" class="java.sql.Timestamp"/>
	<parameter name="P_FECHA_FIN" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT
    k.fecha,
    k.tipo_movimiento,
    k.cantidad,
    k.precio,
    k.cantidad_actual,
    p.nombre_producto
FROM
    public.kardex k
JOIN
    public.producto p ON k.id_producto = p.id_producto
WHERE
    k.id_producto = $P{P_ID_PRODUCTO}::uuid
    AND k.fecha BETWEEN $P{P_FECHA_INICIO}::timestamp with time zone AND $P{P_FECHA_FIN}::timestamp with time zone 
ORDER BY
    k.fecha ASC;]]>
	</queryString>
