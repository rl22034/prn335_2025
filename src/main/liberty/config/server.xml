<server description="new server">
<!--  Enable features  -->
    <featureManager>
        <feature>jakartaee-10.0</feature>
        <feature>jms-3.1</feature> <feature>websocket-2.1</feature>
    </featureManager>

    <messagingEngine>
        <queue id="KardexQueue" forceReliability="ReliablePersistent">
            <properties.wasJms queueName="KardexQueue"/>
        </queue>
    </messagingEngine>

    <jmsConnectionFactory jndiName="jms/KardexConnectionFactory" connectionManagerRef="ConMgr">
        <properties.wasJms/>
    </jmsConnectionFactory>
    <connectionManager id="ConMgr" maxPoolSize="10"/>

    <jmsQueue jndiName="jms/KardexQueue" id="jmsKardexQueue">
        <properties.wasJms queueName="KardexQueue"/>
    </jmsQueue>
<basicRegistry id="basic" realm="BasicRealm">
<!--  <user name="yourUserName" password="" />   -->
</basicRegistry>
<!--  To access this server from a remote client add a host attribute to the following element, e.g. host="*"  -->
<httpEndpoint id="defaultHttpEndpoint" httpPort="9080" httpsPort="9443"/>
<!--  Automatically expand WAR files and EAR files  -->
<applicationManager autoExpand="true"/>
<!--  Default SSL configuration enables trust for default certificates from the Java runtime  -->
<ssl id="defaultSSLConfig" trustDefaultCerts="true"/>
<dataSource id="postgres-driver" jndiName="jdbc/pgdb" jdbcDriverRef="postgresql-driver" type="javax.sql.ConnectionPoolDataSource" transactional="true">
<properties serverName="localhost" databaseName="Inventario_PRN335" portNumber="5432" user="postgres" password="abc123"/>
</dataSource>
<jdbcDriver id="postgresql-driver" javax.sql.DataSource="org.postgres.ds.PGSimpleDataSource" javax.sql.ConnectionPoolDataSource="org.postgresql.ds.PGConnectionPoolDataSource" libraryRef="postgresql-library"/>
<library id="postgresql-library">
<fileset id="PostgresqlFileSet" dir="${wlp.install.dir}/lib" includes="postgresql-42.7.7.jar"/>
</library>
</server>
