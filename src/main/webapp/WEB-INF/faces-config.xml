<?xml version='1.0' encoding='UTF-8'?>
<faces-config version="4.0" xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                                  https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_0.xsd" >


    <!-- CONFIGURACIÓN DE INTERNALIZACIÓN-->

    <application>
        <resource-bundle>
            <base-name>crud</base-name>
            <var>crud</var>
        </resource-bundle>

        <!-- Configuración de idiomas -->
        <locale-config>
            <default-locale>es</default-locale>
            <supported-locale>es</supported-locale>
            <supported-locale>en</supported-locale>
        </locale-config>


    </application>
    <converter>
        <converter-id>clienteConverter</converter-id>

        <converter-class>
            sv.edu.ues.occ.ingenieria.prn335.web.inventariowebappprn335_2025.core.boundory.jsf.converter.ClienteConverter
        </converter-class>
    </converter>
</faces-config>